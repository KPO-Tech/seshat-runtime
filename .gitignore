# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Compiled binaries at repo root or in bin/
/api
/cli
/grpc
/seshat
/seshat-grpc
/seshat-slack
/seshat-auto
bin/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Rust build output (rust/sandboxd, the execution sidecar)
/rust/target/

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work.sum

# Environment files
.env
.env.*
!.env.example
!.env.sample

# Editor/IDE
.idea/
.vscode/

# OS generated files
.DS_Store
Thumbs.db

# Local test artifacts
test.db

# Local tool state
.gemini/
.antigravity/
.claude/
.seshat/
.openclaude-profile.json
.blackboxcli/
claude-code/
private/
helps/
graphify-out/

# Temporary files
*.log
tmp/
.temp/
.cache/
__pycache__
commit.sh
